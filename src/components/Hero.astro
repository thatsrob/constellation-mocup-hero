---
import { BOOK_CALL_URL } from "../data/site-content";

const VIDEO_SRC =
  "https://videos.pexels.com/video-files/2491284/2491284-hd_1920_1080_24fps.mp4";
const VIDEO_POSTER =
  "https://images.pexels.com/photos/313705/pexels-photo-313705.jpeg?auto=compress&cs=tinysrgb&w=1920";

const STATS = [
  { value: "$50M+", label: "Attributable revenue for clients" },
  { value: "98.7%", label: "Client retention in 2024" },
  { value: "3–20×", label: "Average ROI reported" },
];

const AVATARS = [
  "https://i.pravatar.cc/80?img=1",
  "https://i.pravatar.cc/80?img=2",
  "https://i.pravatar.cc/80?img=3",
  "https://i.pravatar.cc/80?img=4",
  "https://i.pravatar.cc/80?img=5",
  "https://i.pravatar.cc/80?img=6",
];

const TESTIMONIAL_IMAGE =
  "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80";
---

<section id="hero" class="relative h-[100dvh] max-h-[100dvh] w-full overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <video
      class="h-full w-full scale-105 object-cover"
      autoplay
      muted
      loop
      playsinline
      poster={VIDEO_POSTER}
    >
      <source src={VIDEO_SRC} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-white/55 backdrop-blur-[14px]"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/20 to-white/70"
    >
    </div>
  </div>

  <div
    class="relative z-10 flex h-full flex-col overflow-hidden"
    style="padding-top: var(--nav-height)"
  >
    <div
      class="grid min-h-0 flex-1 grid-cols-2 gap-4 overflow-hidden px-4 sm:gap-6 sm:px-6 md:gap-8 md:px-10 lg:gap-10 lg:px-14 xl:px-16"
    >
      <div
        class="flex min-h-0 w-full min-w-0 flex-col justify-center gap-2 pr-2 sm:gap-3 sm:pr-4 md:pr-6"
      >
        <h1
          class="text-xl font-bold leading-[1.12] tracking-tight text-pretty text-neutral-950 sm:text-2xl md:text-3xl lg:text-4xl xl:text-[2.65rem]"
        >
          A Law Firm Marketing Agency That Actually Pays for Itself
        </h1>
        <p
          class="text-base font-medium leading-snug text-neutral-900 sm:text-lg md:text-xl"
        >
          More Revenue. More High-Value Cases.
        </p>

        <p class="text-xs font-medium text-neutral-700 sm:text-sm">
          Trusted by 85+ Law Firms Nationwide
        </p>

        <ul class="flex -space-x-1.5" aria-label="Client avatars">
          {
            AVATARS.map((src, i) => (
              <li>
                <img
                  src={src}
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  decoding="async"
                  class="h-7 w-7 rounded-full border-2 border-white object-cover shadow-sm sm:h-8 sm:w-8"
                />
              </li>
            ))
          }
        </ul>

            <a
              href={BOOK_CALL_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex w-fit shrink-0 items-center justify-center rounded-full bg-brand px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand/25 transition-colors hover:bg-brand-dark"
            >
              Let's Talk
            </a>
      </div>

      <div
        class="flex min-h-0 w-full min-w-0 items-center justify-end gap-2.5 py-3 sm:gap-3 sm:py-4 md:gap-4 md:py-5"
      >
        <div class="flex shrink-0 flex-col items-stretch gap-2.5 sm:gap-3">
          {
            STATS.map((stat) => (
              <div class="min-w-[10rem] rounded-xl border border-white/60 bg-white/70 px-4 py-3 shadow-sm backdrop-blur-md sm:min-w-[11.5rem] sm:px-5 sm:py-4">
                <p class="text-xl font-bold tracking-tight text-neutral-950 sm:text-2xl">
                  {stat.value}
                </p>
                <p class="mt-1 text-xs leading-snug text-neutral-600 sm:text-sm">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </div>
        <div
          class="relative h-[min(calc(100%-0.5rem),28rem)] w-full max-w-[min(100%,18rem)] shrink-0 sm:max-w-[min(100%,20rem)] lg:max-w-[min(100%,22rem)]"
        >
          <div
            class="absolute -right-1 top-0 z-20 flex items-center gap-1.5 rounded-lg border border-white/80 bg-white/90 px-2 py-1.5 shadow-md backdrop-blur-md sm:-right-2 sm:px-2.5 sm:py-2"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path>
            </svg>
            <div>
              <p
                class="text-[10px] font-semibold leading-none text-neutral-800 sm:text-xs"
              >
                Rated 5.0 on Google
              </p>
              <span class="inline-flex gap-0.5 text-amber-400" aria-hidden="true">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg class="h-3 w-3 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))
                }
              </span>
            </div>
          </div>

          <div
            class="relative aspect-[4/5] h-full w-full overflow-hidden rounded-tl-[2rem] rounded-tr-lg rounded-b-lg shadow-2xl ring-1 ring-black/5 sm:rounded-tl-[2.75rem]"
          >
            <img
              src={TESTIMONIAL_IMAGE}
              alt="Jameel Manji, Immigration Attorney"
              width="800"
              height="1000"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover object-top grayscale"
            />

            <p
              class="absolute bottom-[30%] left-3 rounded-md bg-white/90 px-2 py-1 text-[10px] font-medium text-neutral-800 shadow backdrop-blur-sm sm:text-xs"
            >
              Jameel Manji, Immigration Attorney
            </p>

            <blockquote
              class="absolute right-2 bottom-2 left-2 rounded-xl border border-white/80 bg-white/92 p-2.5 shadow-xl backdrop-blur-md sm:p-3"
            >
              <span class="inline-flex gap-0.5 text-amber-400" aria-hidden="true">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg class="h-3 w-3 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))
                }
              </span>
              <p
                class="mt-1 text-[10px] font-medium leading-snug text-neutral-800 sm:text-xs"
              >
                "Hiring Constellation Marketing is the BEST business decision I
                have made."
              </p>
            </blockquote>
          </div>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 items-center justify-center py-1.5 sm:py-2">
      <a
        href="#content"
        class="group flex flex-col items-center gap-0.5 text-neutral-700 transition-colors hover:text-neutral-900"
        aria-label="Scroll to content"
      >
        <span
          class="text-[9px] font-semibold uppercase tracking-[0.16em] opacity-75 sm:text-[10px]"
        >
          Explore
        </span>
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full border border-white/70 bg-white/50 shadow-md backdrop-blur-md sm:h-9 sm:w-9"
        >
          <svg
            class="h-3.5 w-3.5 animate-bounce"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

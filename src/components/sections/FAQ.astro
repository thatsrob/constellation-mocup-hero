---
import SectionShell from "../ui/SectionShell.astro";
import { faqs } from "../../data/site-content";
---

<SectionShell id="faq" narrow>
  <div class="text-center">
    <h2 class="text-3xl font-bold tracking-tight text-neutral-950 md:text-4xl">
      Frequently Asked Questions
    </h2>
    <p class="mt-2 text-lg font-medium text-neutral-800">
      Everything You Need to Know
    </p>
    <p class="mt-2 text-neutral-600">
      Straight answers, no marketing fluff—because transparency is how we operate
    </p>
  </div>

  <div class="mt-12 space-y-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-2xl border border-white/60 bg-white/70 shadow-sm backdrop-blur-md open:bg-white/90">
          <summary class="cursor-pointer list-none px-6 py-4 text-base font-semibold text-neutral-900 marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {faq.question}
              <span class="shrink-0 text-brand transition-transform group-open:rotate-45">
                +
              </span>
            </span>
          </summary>
          <p class="border-t border-neutral-100 px-6 pb-5 pt-2 text-sm leading-relaxed text-neutral-600">
            {faq.answer}
          </p>
        </details>
      ))
    }
  </div>
</SectionShell>

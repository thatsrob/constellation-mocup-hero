---
import SectionShell from "../ui/SectionShell.astro";
---

<SectionShell id="deliver" tinted class="!py-16 md:!py-20">
  <div
    class="rounded-3xl border border-white/60 bg-white/75 px-8 py-12 text-center shadow-[0_20px_60px_rgba(15,23,42,0.08)] backdrop-blur-xl md:px-14 md:py-16"
  >
    <h2 class="text-3xl font-bold tracking-tight text-neutral-950 md:text-4xl">
      Marketing Agencies Talk.
      <span class="text-brand-dark">We Deliver.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
      Real ROI and measurable growth for law firms with a digital marketing agency
      focused on outcomes.
    </p>
  </div>
</SectionShell>

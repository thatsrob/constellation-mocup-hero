---
import { BOOK_CALL_URL } from "../../data/site-content";
---

<section
  id="book-call"
  class="relative overflow-hidden bg-neutral-950 px-6 py-24 md:px-10 md:py-32 lg:px-14"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(79,188,133,0.25),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl lg:text-5xl">
      Ready to Start Growing Your Firm?
    </h2>
    <a
      href={BOOK_CALL_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center justify-center rounded-full bg-brand px-10 py-4 text-base font-semibold text-white shadow-lg shadow-brand/30 transition-colors hover:bg-brand-dark"
    >
      Let's Talk
    </a>
  </div>
</section>

---
import SectionShell from "../ui/SectionShell.astro";
import GlassCard from "../ui/GlassCard.astro";
import { whyChoose } from "../../data/site-content";
---

<SectionShell id="why-us">
  <h2 class="text-center text-3xl font-bold tracking-tight text-neutral-950 md:text-4xl">
    Why Top Law Firms Choose Us (And Stay)
  </h2>
  <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-neutral-600">
    Experience the difference of a marketing partner who puts your law firm's
    success ahead of their sales pitch.
  </p>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      whyChoose.map((item) => (
        <GlassCard class="p-6">
          <h3 class="font-bold text-neutral-950">{item.title}</h3>
          <p class="mt-2 text-sm text-neutral-600">{item.description}</p>
        </GlassCard>
      ))
    }
  </div>
</SectionShell>

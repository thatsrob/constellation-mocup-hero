---
import SectionShell from "../ui/SectionShell.astro";
import GlassCard from "../ui/GlassCard.astro";
import { growthSteps } from "../../data/site-content";
---

<SectionShell id="growth-system">
  <div class="text-center">
    <h2 class="text-3xl font-bold tracking-tight text-neutral-950 md:text-4xl">
      The Constellation Growth System
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
      A simple, repeatable framework focused on revenue — not vanity metrics.
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      growthSteps.map((step) => (
        <GlassCard class="relative p-8">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand text-lg font-bold text-white">
            {step.step}
          </span>
          <h3 class="mt-5 text-xl font-bold text-neutral-950">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            {step.description}
          </p>
        </GlassCard>
      ))
    }
</SectionShell>

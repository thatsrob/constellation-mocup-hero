---
import SectionShell from "../ui/SectionShell.astro";
import GlassCard from "../ui/GlassCard.astro";
import { painPoints, painPointsIntro } from "../../data/site-content";
---

<SectionShell id="pain-points">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-neutral-950 md:text-4xl">
      {painPointsIntro.title}
    </h2>
    <p class="mt-4 text-lg text-neutral-600">{painPointsIntro.subtitle}</p>
  </div>

  <div class="mt-14 space-y-8">
    {
      painPoints.map((item) => (
        <div class="grid gap-4 lg:grid-cols-2 lg:gap-6">
          <GlassCard class="border-red-100/80 bg-red-50/40 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-red-600">
              The problem
            </p>
            <p class="mt-2 text-lg font-semibold text-neutral-900">
              "{item.problem}"
            </p>
            <p class="mt-2 text-sm text-neutral-600">{item.problemDetail}</p>
          </GlassCard>
          <GlassCard class="border-brand/30 bg-brand-light/50 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-dark">
              Our approach
            </p>
            <h3 class="mt-2 text-lg font-semibold text-neutral-900">
              {item.solution}
            </h3>
            <p class="mt-2 text-sm text-neutral-600">{item.solutionDetail}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.badges.map((badge) => (
                <span class="rounded-full border border-brand/25 bg-white/80 px-3 py-1 text-xs font-semibold text-brand-dark backdrop-blur-sm">
                  {badge}
                </span>
              ))}
            </div>
          </GlassCard>
        </div>
      ))
    }
  </div>
</SectionShell>

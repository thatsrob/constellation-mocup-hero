---
const {
  id,
  class: className = "",
  tinted = false,
  narrow = false,
} = Astro.props;

const bg = tinted ? "bg-brand-light/40" : "bg-white";
const width = narrow ? "max-w-4xl" : "max-w-6xl";
---

<section id={id} class={`${bg} px-6 py-20 md:px-10 md:py-28 lg:px-14 ${className}`}>
  <div class={`mx-auto ${width}`}>
    <slot />
  </div>
</section>
